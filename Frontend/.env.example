# Campus Coin (client) — environment variables
# Copy this file to .env.local and fill in real values. Vite only exposes
# variables prefixed with VITE_ to client code.

# Local backend REST API. Set the production value to the deployed backend URL
# ending in /api/v1 (for example, https://campuscoin-backend.vercel.app/api/v1).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Feature flags — keep AI features off until a provider is wired up server-side.
VITE_FEATURE_AI_CATEGORIZATION=false
VITE_FEATURE_AI_INSIGHTS=false

# Google Sign-In: no client-side env var needed. The frontend fetches the
# OAuth client ID from the backend (GET /auth/google/config), which reads it
# from its own GOOGLE_CLIENT_ID — configure it there, not here. Add both this
# app's origin and the deployed frontend origin under "Authorized JavaScript
# origins" on that Google Cloud OAuth client
# (https://console.cloud.google.com/apis/credentials).
