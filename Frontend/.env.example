# Campus Coin (client) — environment variables
# Copy this file to .env.local and fill in real values. Vite only exposes
# variables prefixed with VITE_ to client code.

# Local backend REST API. Set the production value to the deployed backend URL
# ending in /api/v1 (for example, https://campuscoin-api.vercel.app/api/v1).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Feature flags — keep AI features off until a provider is wired up server-side.
VITE_FEATURE_AI_CATEGORIZATION=false
VITE_FEATURE_AI_INSIGHTS=false

# Google Sign-In — OAuth 2.0 Client ID (Web application) from
# https://console.cloud.google.com/apis/credentials. Add both this app's
# origin and the deployed frontend origin under "Authorized JavaScript
# origins" on that client. The matching GOOGLE_CLIENT_ID must also be set on
# the backend (same value) so it can verify the ID token this produces.
VITE_GOOGLE_CLIENT_ID=
