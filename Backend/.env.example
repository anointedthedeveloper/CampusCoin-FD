# Campus Coin (backend) — environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API via CORS
# (e.g. local dev + the deployed frontend). Must match exactly, including
# scheme and port, no trailing slash.
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────
# Use a mongodb+srv:// Atlas connection string in production. A plain
# mongodb://host:port/db string also works (local dev, CI, Docker).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscoin
# Optional: override DNS resolvers if your network can't resolve the Atlas
# SRV record by default (comma-separated).
MONGODB_DNS_SERVERS=

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Long, random secret used to sign access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Google Sign-In (Google Identity Services ID-token flow) ──────────────
# OAuth 2.0 Client ID (Web application) from
# https://console.cloud.google.com/apis/credentials. Must be the SAME value
# as the frontend's VITE_GOOGLE_CLIENT_ID — this backend verifies the ID
# token's audience against it. Leave unset to disable Google sign-in
# (POST /api/v1/auth/google will respond 503).
GOOGLE_CLIENT_ID=

# ── Email (password reset, welcome, notifications, support replies) ─────
# Set at least ONE option. Several can be set: they are tried in the order
# Brevo → Resend → SMTP, so if one fails the next one delivers the mail.
# In production, forgot-password returns a clear "not set up" error when none
# is configured; in development the code and link are printed to the log.
# Admins can check delivery and send a test email from Admin → My Profile.
#
# Option A — Brevo (RECOMMENDED, free 300 emails/day, delivers to anyone):
#   1. Sign up at https://www.brevo.com
#   2. Senders & IP → Senders → add and verify your own email (e.g. a Gmail)
#   3. SMTP & API → API Keys → create a key
BREVO_API_KEY=
# The verified sender, e.g. "Campus Coin <yourname@gmail.com>"
BREVO_SENDER=
#
# Option B — Resend: https://resend.com. Without a verified domain Resend
# only delivers to your own account email, so verify a domain for real users.
RESEND_API_KEY=
#
# Option C — SMTP, e.g. Gmail: turn on 2-Step Verification, create an App
# Password (https://myaccount.google.com/apppasswords) and use:
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=465
#   EMAIL_USER=you@gmail.com   EMAIL_PASS=<16-char app password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Where Help-page contact messages are emailed (defaults to EMAIL_USER).
# Messages are always kept in the admin Support inbox too.
SUPPORT_EMAIL=
# Sender shown in the email, e.g. "Campus Coin <you@gmail.com>".
EMAIL_FROM=

# ── AI (optional) ─────────────────────────────────────────────────────────
# Gemini serves AI answers, category suggestions, and monthly insights.
# Category suggestions and monthly insights fall back to rules if unset.
GEMINI_API_KEY=
# Several Gemini keys, comma-separated (same failover as GROQ_API_KEYS).
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000
GROQ_API_KEY=
# Several Groq keys, comma-separated. If one is rate-limited or invalid the
# next is used automatically (then Gemini keys, if any).
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000

# ── Daily backups ─────────────────────────────────────────────────────────
# Students are backed up automatically once a day when they open the app.
# To also back up students who don't log in, set CRON_SECRET to any long
# random string: Vercel Cron (vercel.json) then calls
# /api/v1/cron/daily-backups every night with it.
CRON_SECRET=
