# Campus Coin (backend) — environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API via CORS
# (e.g. local dev + the deployed frontend). Must match exactly, including
# scheme and port, no trailing slash.
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────
# Use a mongodb+srv:// Atlas connection string in production. A plain
# mongodb://host:port/db string also works (local dev, CI, Docker).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscoin
# Optional: override DNS resolvers if your network can't resolve the Atlas
# SRV record by default (comma-separated).
MONGODB_DNS_SERVERS=

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Long, random secret used to sign access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Google Sign-In (Google Identity Services ID-token flow) ──────────────
# OAuth 2.0 Client ID (Web application) from
# https://console.cloud.google.com/apis/credentials. Must be the SAME value
# as the frontend's VITE_GOOGLE_CLIENT_ID — this backend verifies the ID
# token's audience against it. Leave unset to disable Google sign-in
# (POST /api/v1/auth/google will respond 503).
GOOGLE_CLIENT_ID=

# ── Email (password reset) ────────────────────────────────────────────────
# Set ONE of these options. In production, forgot-password returns a clear
# "not set up" error when neither is configured; in development the code and
# link are printed to the server log instead.
#
# Option A — Resend (simplest on Vercel): create a key at https://resend.com.
# Without a verified domain Resend only delivers to your own account email,
# so verify a domain (or use SMTP) for real users.
RESEND_API_KEY=
#
# Option B — SMTP, e.g. Gmail: turn on 2-Step Verification, create an App
# Password (https://myaccount.google.com/apppasswords) and use:
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=465
#   EMAIL_USER=you@gmail.com   EMAIL_PASS=<16-char app password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Where Help-page contact messages are emailed (defaults to EMAIL_USER).
# Messages are always kept in the admin Support inbox too.
SUPPORT_EMAIL=
# Sender shown in the email, e.g. "Campus Coin <you@gmail.com>".
EMAIL_FROM=

# ── AI (optional) ─────────────────────────────────────────────────────────
# Gemini serves AI answers, category suggestions, and monthly insights.
# Category suggestions and monthly insights fall back to rules if unset.
GEMINI_API_KEY=
# Several Gemini keys, comma-separated (same failover as GROQ_API_KEYS).
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000
GROQ_API_KEY=
# Several Groq keys, comma-separated. If one is rate-limited or invalid the
# next is used automatically (then Gemini keys, if any).
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
