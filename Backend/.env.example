# Campus Coin (backend) — environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API via CORS
# (e.g. local dev + the deployed frontend). Must match exactly, including
# scheme and port, no trailing slash.
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────
# Use a mongodb+srv:// Atlas connection string in production. A plain
# mongodb://host:port/db string also works (local dev, CI, Docker).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscoin
# Optional: override DNS resolvers if your network can't resolve the Atlas
# SRV record by default (comma-separated).
MONGODB_DNS_SERVERS=

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Long, random secret used to sign access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Google Sign-In (Google Identity Services ID-token flow) ──────────────
# OAuth 2.0 Client ID (Web application) from
# https://console.cloud.google.com/apis/credentials. Must be the SAME value
# as the frontend's VITE_GOOGLE_CLIENT_ID — this backend verifies the ID
# token's audience against it. Leave unset to disable Google sign-in
# (POST /api/v1/auth/google will respond 503).
GOOGLE_CLIENT_ID=

# ── Email (password reset) ────────────────────────────────────────────────
# SMTP credentials used to send password-reset emails. If left unset, the
# reset link is only logged server-side (useful for local dev) instead of
# emailed — forgot-password still works, it just won't reach the user.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── AI (optional) ─────────────────────────────────────────────────────────
# If unset, AI categorization/insights fall back to rule-based logic instead
# of failing.
OPENAI_API_KEY=
